---
import Layout from '../layouts/Layout.astro';
const title = 'Projecten | BB Kunststof Kozijnen';
const description = 'Bekijk onze projecten met placeholderfoto’s van kunststof kozijnen en montageoplossingen.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.3em] text-accent">Projecten</p>
        <h1 class="mt-4 text-4xl font-semibold text-text-white sm:text-5xl">Projectfoto’s in ontwikkeling</h1>
        <p class="mt-6 text-text-cream">Deze pagina toont tijdelijke placeholderfoto’s. De definitieve projectbeelden worden later toegevoegd.</p>
      </div>
    </div>
  </section>

  <section class="section-light border-t border-border-light text-text-dark">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="text-center mb-12">
        <p class="text-sm uppercase tracking-[0.2em] label">Placeholder projecten</p>
        <h2 class="mt-4 text-3xl font-semibold">Nog te vervangen projectfoto’s</h2>
        <p class="mt-4 max-w-2xl mx-auto text-text-grey">Hier komen later echte projectfoto’s van uitgevoerde kunststof kozijnen en montageprojecten.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <article class="overflow-hidden rounded-3xl bg-bg-white shadow-md shadow-slate-200/50">
          <img src="https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=600" alt="Projectfoto placeholder 1" class="h-72 w-full object-cover" loading="lazy" />
          <div class="p-5">
            <p class="text-sm uppercase tracking-[0.2em] label">Projectfoto placeholder</p>
          </div>
        </article>
        <article class="overflow-hidden rounded-3xl bg-bg-white shadow-md shadow-slate-200/50">
          <img src="https://images.unsplash.com/photo-1523217582562-09d0def993a6?w=600" alt="Projectfoto placeholder 2" class="h-72 w-full object-cover" loading="lazy" />
          <div class="p-5">
            <p class="text-sm uppercase tracking-[0.2em] label">Projectfoto placeholder</p>
          </div>
        </article>
        <article class="overflow-hidden rounded-3xl bg-bg-white shadow-md shadow-slate-200/50">
          <img src="https://images.unsplash.com/photo-1449844908441-8829872d2607?w=600" alt="Projectfoto placeholder 3" class="h-72 w-full object-cover" loading="lazy" />
          <div class="p-5">
            <p class="text-sm uppercase tracking-[0.2em] label">Projectfoto placeholder</p>
          </div>
        </article>
        <article class="overflow-hidden rounded-3xl bg-bg-white shadow-md shadow-slate-200/50">
          <img src="https://images.unsplash.com/photo-1502005229762-cf1b2da7c5d6?w=600" alt="Projectfoto placeholder 4" class="h-72 w-full object-cover" loading="lazy" />
          <div class="p-5">
            <p class="text-sm uppercase tracking-[0.2em] label">Projectfoto placeholder</p>
          </div>
        </article>
        <article class="overflow-hidden rounded-3xl bg-bg-white shadow-md shadow-slate-200/50">
          <img src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600" alt="Projectfoto placeholder 5" class="h-72 w-full object-cover" loading="lazy" />
          <div class="p-5">
            <p class="text-sm uppercase tracking-[0.2em] label">Projectfoto placeholder</p>
          </div>
        </article>
        <article class="overflow-hidden rounded-3xl bg-bg-white shadow-md shadow-slate-200/50">
          <img src="https://images.unsplash.com/photo-1484154218962-a197022b5858?w=600" alt="Projectfoto placeholder 6" class="h-72 w-full object-cover" loading="lazy" />
          <div class="p-5">
            <p class="text-sm uppercase tracking-[0.2em] label">Projectfoto placeholder</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>
