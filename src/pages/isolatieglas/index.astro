---
import Layout from '../../layouts/Layout.astro';
const title = 'Hoogwaardig isolatieglas';
const description = 'Hoogwaardig isolatieglas zorgt voor meer comfort en lagere energiekosten.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <span>Isolatieglas</span>
      </nav>

      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.3em] label">Isolatieglas</p>
        <h1 class="mt-4 text-4xl font-semibold">Hoogwaardig isolatieglas</h1>
        <p class="mt-6 text-lg leading-8">Hoogwaardig isolatieglas zorgt voor meer comfort en lagere energiekosten. Met de juiste glasoplossing verhoogt u het wooncomfort en de waarde van uw woning.</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <a href="/isolatieglas/hr-plus-plus" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">HR++</h2>
          <p class="mt-3">Uitstekende isolatie met een optimale prijs-kwaliteitverhouding.</p>
        </a>
        <a href="/isolatieglas/hr-plus-plus-plus" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">HR+++ </h2>
          <p class="mt-3">Triple glas met maximale isolatiewaarden voor optimaal comfort en minimale warmteverliezen.</p>
        </a>
      </div>

      <div class="mt-16 text-center">
        <a href="/offerte" class="btn-primary inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold">Vraag een offerte aan</a>
      </div>
    </div>
  </section>
</Layout>

