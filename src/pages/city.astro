---
import Layout from '../layouts/Layout.astro';
const title = 'City kunststof kozijnen | BB Kunststof Kozijnen';
const description = 'City kozijnen voor compacte ruimtes en stedelijke woningen met een moderne en efficiënte uitstraling.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.3em] text-accent">City</p>
        <h1 class="mt-4 text-4xl font-semibold text-text-dark sm:text-5xl">Compacte kozijnen voor stedelijke woningen</h1>
        <p class="mt-6 text-text-grey leading-8">City biedt slimme inbouw en een slank profiel, perfect voor appartementen, kleine gevels en moderne stadswoningen met een strak uiterlijk.</p>
        <div class="mt-10 overflow-hidden rounded-[2rem] aspect-[4/3] bg-bg-light">
          <img src="https://www.schipperkozijnen.nl/source/hefschuifpui%20wit%20keuken.jpg" alt="City kunststof kozijnen met schuifpui" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href="/offerte-aanvragen" class="btn-primary inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold">Offerte aanvragen</a>
          <a href="/" class="btn-secondary inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold">Terug naar home</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark border-t border-border-light text-text-dark">
    <div class="mx-auto max-w-7xl px-6 py-16 grid gap-10 lg:grid-cols-3">
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Waarom City</p>
        <ul class="mt-6 space-y-3 text-text-grey">
          <li>Smalle zichtlijnen</li>
          <li>Maximale lichtinval</li>
          <li>Stevige constructie voor kleinere ruimtes</li>
          <li>Ideaal voor stedelijke renovatie</li>
        </ul>
      </div>
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Stijl</p>
        <p class="mt-6 text-text-grey">Elegant en modern, met een minimalistische uitstraling die goed past bij strakke interieurs.</p>
      </div>
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Installatie</p>
        <p class="mt-6 text-text-grey">Snelle montage met extra aandacht voor afwatering en luchtdichtheid in stedelijke situaties.</p>
      </div>
    </div>
  </section>
</Layout>

