---
import Layout from '../layouts/Layout.astro';
const title = 'Offerte aanvragen | BB Kunststof Kozijnen';
const description = 'Vraag een vrijblijvende offerte aan voor kunststof kozijnen. Vul het formulier in en wij nemen contact met u op.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.3em] text-accent">Offerte aanvragen</p>
        <h1 class="mt-4 text-4xl font-semibold text-text-dark sm:text-5xl">Vraag vandaag een vrijblijvende offerte aan</h1>
        <p class="mt-6 text-text-grey leading-8">Vul onderstaand formulier in, dan nemen we snel contact met u op om uw project te bespreken.</p>
      </div>
      <form action="https://formspree.io/f/your-form-id" method="POST" class="mt-12 grid gap-6 rounded-3xl card-light p-8">
        <div class="grid gap-6 lg:grid-cols-2">
          <label class="block text-sm text-text-dark">
            <span class="text-text-grey">Naam</span>
            <input name="name" type="text" required class="mt-2 w-full rounded-2xl border border-border-light bg-bg-white px-4 py-3 text-text-dark outline-none transition focus-border-accent" />
          </label>
          <label class="block text-sm text-text-dark">
            <span class="text-text-grey">E-mail</span>
            <input name="email" type="email" required class="mt-2 w-full rounded-2xl border border-border-light bg-bg-white px-4 py-3 text-text-dark outline-none transition focus-border-accent" />
          </label>
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
          <label class="block text-sm text-text-dark">
            <span class="text-text-grey">Telefoonnummer</span>
            <input name="phone" type="tel" class="mt-2 w-full rounded-2xl border border-border-light bg-bg-white px-4 py-3 text-text-dark outline-none transition focus-border-accent" />
          </label>
          <label class="block text-sm text-text-dark">
            <span class="text-text-grey">Postcode & woonplaats</span>
            <input name="address" type="text" required class="mt-2 w-full rounded-2xl border border-border-light bg-bg-white px-4 py-3 text-text-dark outline-none transition focus-border-accent" />
          </label>
        </div>

        <label class="block text-sm text-text-dark">
          <span class="text-text-grey">Projectomschrijving</span>
          <textarea name="message" rows="5" class="mt-2 w-full rounded-3xl border border-border-light bg-bg-white px-4 py-3 text-text-dark outline-none transition focus-border-accent"></textarea>
        </label>

        <label class="flex items-center gap-3 text-sm text-text-grey">
          <input type="checkbox" name="consent" required class="h-4 w-4 rounded border-border-light bg-bg-white text-accent focus-ring-accent" />
          Ik ga akkoord met algemene voorwaarden en standaard contact.
        </label>

        <button type="submit" class="btn-primary inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold">Verstuur offerte-aanvraag</button>
      </form>
    </div>
  </section>
</Layout>
