---
import Layout from '../../layouts/Layout.astro';
const title = 'Cube – Kunststof kozijnen';
const description = 'Een strak, modern en kubistisch design voor een luxe uitstraling.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <a href="/kunststof">Kunststof kozijnen</a>
        <span>›</span>
        <span class="current">Cube</span>
      </nav>
      <h1 class="mt-4 text-4xl font-semibold">Cube</h1>
      <p class="mt-6 text-lg leading-8">Een strak, modern en kubistisch design voor een luxe uitstraling.</p>
      <div class="mt-10 overflow-hidden rounded-2xl">
        <img
          src="https://www.schipperkozijnen.nl/source/9E3A0563%20K-VISION%20Cube%20hoekdetail%20kunststof%20kozijn.jpg"
          alt="Cube kunststof kozijn hoekdetail"
          class="w-full object-cover max-h-96"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section-dark section-light border-t border-border-light">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] label">Voordelen</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-3xl card-soft p-6">Modern design</div>
          <div class="rounded-3xl card-soft p-6">Kubistische lijnen</div>
          <div class="rounded-3xl card-soft p-6">Luxe uitstraling</div>
          <div class="rounded-3xl card-soft p-6">Energiezuinig</div>
        </div>
      </div>
      <div class="mt-12 text-center">
        <a href="/offerte" class="btn-primary inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold">Vraag een offerte aan</a>
      </div>
    </div>
  </section>
</Layout>
