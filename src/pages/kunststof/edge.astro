---
import Layout from '../../layouts/Layout.astro';
const title = 'Edge – Kunststof kozijnen';
const description = 'Minimalistische lijnen en een moderne afwerking voor een stijlvolle uitstraling.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <a href="/kunststof">Kunststof kozijnen</a>
        <span>›</span>
        <span>Edge</span>
      </nav>
      <p class="text-sm uppercase tracking-[0.3em] label">Edge</p>
      <h1 class="mt-4 text-4xl font-semibold">Edge</h1>
      <p class="mt-6 text-lg leading-8">Minimalistische lijnen en een moderne afwerking voor een stijlvolle uitstraling.</p>
    </div>
  </section>

  <section class="section-dark section-dark border-t border-border-light">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] label">Voordelen</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-3xl card-soft p-6">Minimalistisch design</div>
          <div class="rounded-3xl card-soft p-6">Moderne afwerking</div>
          <div class="rounded-3xl card-soft p-6">Stijlvolle uitstraling</div>
          <div class="rounded-3xl card-soft p-6">Onderhoudsarm</div>
        </div>
      </div>
      <div class="mt-12 text-center">
        <a href="/offerte" class="btn-primary inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold">Vraag een offerte aan</a>
      </div>
    </div>
  </section>
</Layout>


