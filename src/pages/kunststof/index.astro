---
import Layout from '../../layouts/Layout.astro';
const title = 'Kunststof kozijnen op maat';
const description = 'Onze kunststof kozijnen combineren uitstraling, duurzaamheid en optimaal comfort.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <span>Kunststof kozijnen</span>
      </nav>

      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.3em] label">Kunststof kozijnen</p>
        <h1 class="mt-4 text-4xl font-semibold">Kunststof kozijnen op maat</h1>
        <p class="mt-6 text-lg leading-8">Onze kunststof kozijnen combineren uitstraling, duurzaamheid en optimaal comfort. Onderhoudsarm, energiezuinig, lange levensduur, uitstekende geluidsisolatie. Verkrijgbaar in diverse kleuren en afwerkingen. Wij leveren de profieltypes City, Cube, Warmcore en Edge.</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-4">
        <a href="/kunststof/city" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">City</h2>
          <p class="mt-3">Een slank en tijdloos profiel dat perfect past bij renovatieprojecten en klassieke woningen.</p>
        </a>
        <a href="/kunststof/cube" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">Cube</h2>
          <p class="mt-3">Een strak, modern en kubistisch design voor een luxe uitstraling.</p>
        </a>
        <a href="/kunststof/warmcore" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">Warmcore</h2>
          <p class="mt-3">Maximale isolatie dankzij innovatieve technologie en extra hoge energieprestaties.</p>
        </a>
        <a href="/kunststof/edge" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">Edge</h2>
          <p class="mt-3">Minimalistische lijnen en een moderne afwerking voor een stijlvolle uitstraling.</p>
        </a>
      </div>

      <div class="mt-16 text-center">
        <a href="/offerte" class="btn-primary inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold">Vraag een offerte aan</a>
      </div>
    </div>
  </section>
</Layout>


