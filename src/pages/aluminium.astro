---
import Layout from '../layouts/Layout.astro';
const title = 'Aluminium kozijnen';
const description = 'Aluminium kozijnen binnenkort meer informatie.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <span class="current">Aluminium kozijnen</span>
      </nav>
      <h1 class="mt-4 text-4xl font-semibold">Aluminium kozijnen</h1>
      <p class="mt-6 text-lg leading-8">Aluminium kozijnen — binnenkort meer informatie. Neem contact op voor advies.</p>
      <div class="mt-12 text-center">
        <a href="/offerte" class="btn-primary inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold">Vraag een offerte aan</a>
      </div>
    </div>
  </section>
</Layout>

