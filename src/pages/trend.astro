---
import Layout from '../layouts/Layout.astro';
const title = 'Trend kunststof kozijnen | BB Kunststof Kozijnen';
const description = 'Trend kozijnen met een tijdloze stijl en uitstekende isolatie voor energiebewuste woningeigenaren.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.3em] text-accent">Trend</p>
        <h1 class="mt-4 text-4xl font-semibold text-text-dark sm:text-5xl">Tijdloze kozijnen met veel comfort</h1>
        <p class="mt-6 text-text-grey leading-8">Trend is onze meest veelzijdige lijn. Deze kozijnen combineren een klassiek profiel met moderne isolatietechniek en bieden een fijne balans tussen stijl en prestatie.</p>
        <div class="mt-10 overflow-hidden rounded-[2rem] aspect-[4/3] bg-bg-light">
          <img src="https://www.schipperkozijnen.nl/source/kunststof%20Kozijn%20met%20draaideel%20Woodline%20Houtnerf.jpg" alt="Trend kunststof kozijn met draaideel" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href="/offerte-aanvragen" class="btn-primary inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold">Offerte aanvragen</a>
          <a href="/" class="btn-secondary inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold">Terug naar home</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark border-t border-border-light text-text-dark">
    <div class="mx-auto max-w-7xl px-6 py-16 grid gap-10 lg:grid-cols-3">
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Voordelen</p>
        <ul class="mt-6 space-y-3 text-text-grey">
          <li>Robuust profiel met subtiele details</li>
          <li>Optimale geluidsisolatie</li>
          <li>Verschillende kleuren en glasopties</li>
          <li>Uitstekende prijs-kwaliteit</li>
        </ul>
      </div>
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Geschikt voor</p>
        <p class="mt-6 text-text-grey">Eengezinswoningen, rijtjeshuizen en huizen met een klassieke of landelijke uitstraling.</p>
      </div>
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Garantie</p>
        <p class="mt-6 text-text-grey">Wij geven 10 jaar garantie op alle kunststof profielen en afwerking, inclusief montage.</p>
      </div>
    </div>
  </section>
</Layout>

