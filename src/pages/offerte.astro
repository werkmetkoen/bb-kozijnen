---
import Layout from '../layouts/Layout.astro';
const title = 'Offerte aanvragen';
const description = 'Vraag een vrijblijvende offerte aan voor kunststof kozijnen, isolatieglas of horren.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <span>Offerte</span>
      </nav>
      <p class="text-sm uppercase tracking-[0.3em] label">Offerte</p>
      <h1 class="mt-4 text-4xl font-semibold">Offerte aanvragen</h1>
      <p class="mt-6 text-lg leading-8">Vul het formulier in voor een vrijblijvende offerte op maat. Wij nemen binnen 24 uur contact met u op om uw wensen te bespreken.</p>
      <div class="mt-12 text-center">
        <a href="/offerte-aanvragen" class="btn-primary inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold">Naar offertepagina</a>
      </div>
    </div>
  </section>
</Layout>

