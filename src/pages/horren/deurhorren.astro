---
import Layout from '../../layouts/Layout.astro';
const title = 'Deurhorren';
const description = 'Stevige hordeuren voor optimale ventilatie met draai- of schuifuitvoering.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <a href="/horren">Horren</a>
        <span>›</span>
        <span>Deurhorren</span>
      </nav>
      <p class="text-sm uppercase tracking-[0.3em] label">Deurhorren</p>
      <h1 class="mt-4 text-4xl font-semibold">Deurhorren</h1>
      <p class="mt-6 text-lg leading-8">Stevige hordeuren voor optimale ventilatie. Verkrijgbaar als draai- of schuifuitvoering.</p>
      <div class="mt-12 text-center">
        <a href="/offerte" class="btn-primary inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold">Vraag een offerte aan</a>
      </div>
    </div>
  </section>
</Layout>

