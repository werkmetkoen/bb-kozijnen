---
import Layout from '../../layouts/Layout.astro';
const title = 'Inzethorren';
const description = 'Eenvoudig te plaatsen inzethor die past in het kozijnrabbat.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <a href="/horren">Horren</a>
        <span>›</span>
        <span class="current">Inzethorren</span>
      </nav>
      <h1 class="mt-4 text-4xl font-semibold">Inzethorren</h1>
      <p class="mt-6 text-lg leading-8">Eenvoudig te plaatsen inzethor die past in het kozijnrabbat. Geen boren of schroeven nodig.</p>
      <div class="mt-12 text-center">
        <a href="/offerte" class="btn-primary inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold">Vraag een offerte aan</a>
      </div>
    </div>
  </section>
</Layout>

