---
import Layout from '../../layouts/Layout.astro';
const title = 'Horren op maat';
const description = 'Hoogwaardige horren voor optimale ventilatie terwijl insecten buiten blijven.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <span>Horren</span>
      </nav>

      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.3em] label">Horren</p>
        <h1 class="mt-4 text-4xl font-semibold">Horren op maat</h1>
        <p class="mt-6 text-lg leading-8">Hoogwaardige horren voor optimale ventilatie terwijl insecten buiten blijven. Naadloos passend bij uw kozijnen. Duurzaam, onderhoudsarm en verkrijgbaar in diverse kleuren.</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <a href="/horren/inzethorren" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">Inzethorren</h2>
          <p class="mt-3">Eenvoudig te plaatsen inzethor die past in het kozijnrabbat. Geen boren of schroeven nodig.</p>
        </a>
        <a href="/horren/rolhorren" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">Rolhorren</h2>
          <p class="mt-3">Praktische rolhor die oprolt in een cassette boven het kozijn. Ideaal voor grote ramen en deuren.</p>
        </a>
        <a href="/horren/plisse" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">Plissé</h2>
          <p class="mt-3">Elegante plissé hor die harmonicavoudig openvouwt. Geschikt voor ramen en deuren.</p>
        </a>
        <a href="/horren/deurhorren" class="rounded-3xl card-light p-8 transition hover:border-border-light hover-bg-dark">
          <h2 class="text-xl font-semibold">Deurhorren</h2>
          <p class="mt-3">Stevige hordeuren voor optimale ventilatie. Verkrijgbaar als draai- of schuifuitvoering.</p>
        </a>
      </div>

      <div class="mt-16 text-center">
        <a href="/offerte" class="btn-primary inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold">Vraag een offerte aan</a>
      </div>
    </div>
  </section>
</Layout>

