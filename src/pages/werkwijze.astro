---
import Layout from '../layouts/Layout.astro';
const title = 'Werkwijze | BB Kunststof Kozijnen';
const description = 'Ontdek de werkwijze van BB Kunststof Kozijnen: van advies tot montage en nazorg met duidelijkheid en kwaliteit.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div class="mx-auto max-w-3xl">
          <p class="text-sm uppercase tracking-[0.3em] text-accent">Werkwijze</p>
          <h1 class="mt-4 text-4xl font-semibold text-text-dark sm:text-5xl">Onze heldere stap-voor-stap aanpak</h1>
          <p class="mt-6 text-text-grey leading-8">Wij zorgen voor een soepel traject van oriëntatie, advies en maatwerk tot professionele montage en nazorg.</p>
        </div>
        <div class="overflow-hidden rounded-[2rem] aspect-[4/3] bg-bg-light">
          <img src="https://balfoortbouw.nl/onewebstatic/a028415ce8.jpg" alt="Werkplaats en montage van kunststof kozijnen" class="h-full w-full object-cover" loading="lazy" />
        </div>
      </div>
      <div class="mt-16 grid gap-8 lg:grid-cols-2">
        <div class="rounded-3xl card-light p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-accent">Stap 1</p>
          <h2 class="mt-4 text-2xl font-semibold text-text-dark">Kennismaken en adviseren</h2>
          <p class="mt-4 text-text-grey">We bespreken uw wensen en bekijken welke kozijnen het beste passen bij uw woning en budget.</p>
        </div>
        <div class="rounded-3xl card-light p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-accent">Stap 2</p>
          <h2 class="mt-4 text-2xl font-semibold text-text-dark">Inmeten op locatie</h2>
          <p class="mt-4 text-text-grey">Een nauwkeurige inmeting zorgt dat uw kozijnen straks perfect passen en energiezuinig presteren.</p>
        </div>
        <div class="rounded-3xl card-light p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-accent">Stap 3</p>
          <h2 class="mt-4 text-2xl font-semibold text-text-dark">Offerte en planning</h2>
          <p class="mt-4 text-text-grey">We sturen een heldere offerte met levertermijn en details over materialen, kleuren en montage.</p>
        </div>
        <div class="rounded-3xl card-light p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-accent">Stap 4</p>
          <h2 class="mt-4 text-2xl font-semibold text-text-dark">Montage zonder zorgen</h2>
          <p class="mt-4 text-text-grey">Onze monteurs werken netjes, volgens planning en met minimale overlast voor uw gezin.</p>
        </div>
        <div class="rounded-3xl card-light p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-accent">Stap 5</p>
          <h2 class="mt-4 text-2xl font-semibold text-text-dark">Nazorg en garantie</h2>
          <p class="mt-4 text-text-grey">Na montage controleren we alles nogmaals en staat onze service klaar voor eventuele vragen.</p>
        </div>
        <div class="rounded-3xl card-soft p-8 flex flex-col justify-between">
          <div>
            <p class="text-sm uppercase tracking-[0.2em] text-accent">Duurzaamheid</p>
            <p class="mt-4 text-text-grey">Onze kozijnen zijn energiezuinig en levensloopbestendig, met een lange levensduur en beperkt onderhoud.</p>
          </div>
          <a href="/offerte-aanvragen" class="mt-6 btn-primary inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold">Vraag direct een offerte aan</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
