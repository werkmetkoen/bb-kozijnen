---
import Layout from '../layouts/Layout.astro';
const title = 'Classic kunststof kozijnen | BB Kunststof Kozijnen';
const description = 'Classic kunststof kozijnen met een tijdloos design voor landelijke en traditionele woningen.';
---

<Layout {title} {description}>
  <section class="section-dark page-hero">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.3em] text-accent">Classic</p>
        <h1 class="mt-4 text-4xl font-semibold text-text-dark sm:text-5xl">Kozijnen met tijdloze charme</h1>
        <p class="mt-6 text-text-grey leading-8">Classic is ontworpen voor wie graag een rustige, elegante uitstraling kiest. Dit model combineert een warme stijl met uitstekende isolatie en duurzaamheid.</p>
        <div class="mt-10 overflow-hidden rounded-[2rem] aspect-[4/3] bg-bg-light">
          <img src="https://www.schipperkozijnen.nl/source/city%20k-vision%20kunststof%20kozijnen%20grijs-wit.jpg" alt="Classic kunststof kozijnen in een woning" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href="/offerte-aanvragen" class="btn-primary inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold">Offerte aanvragen</a>
          <a href="/" class="btn-secondary inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold">Terug naar home</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark border-t border-border-light text-text-dark">
    <div class="mx-auto max-w-7xl px-6 py-16 grid gap-10 lg:grid-cols-3">
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Eigenschappen</p>
        <ul class="mt-6 space-y-3 text-text-grey">
          <li>Warm en uitnodigend profiel</li>
          <li>Beschikbaar in klassieke kleuren</li>
          <li>Extra sterke montage voor jarenlange stabiliteit</li>
          <li>Geschikt voor monumentale en woningbouwprojecten</li>
        </ul>
      </div>
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Perfect voor</p>
        <p class="mt-6 text-text-grey">Rijtjeshuizen, jaren â€™30 woningen en woningen met een klassieke uitstraling.</p>
      </div>
      <div class="rounded-3xl card-light p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Energievoordeel</p>
        <p class="mt-6 text-text-grey">Uitstekende isolatie houdt warmte binnen en verlaagt uw energierekening.</p>
      </div>
    </div>
  </section>
</Layout>

