---
import '../styles/global.css';
import Logo from '../assets/logo.svg?raw';

const { title = 'BB Kunststof Kozijnen', description = 'Professionele kunststof kozijnen voor particulieren in Nederland.' } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <style>html { scroll-behavior: smooth; }</style>
  </head>
  <body class="bg-white text-[#333333] antialiased">
    <div class="min-h-screen flex flex-col">
      <header class="bg-white border-b border-[#e5e7eb] sticky top-0 z-50">
        <div class="mx-auto max-w-7xl px-6 py-3 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="w-48">
            <a href="/" class="block hover:opacity-80">
              <svg viewBox="0 0 300 80" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
                <!-- Window frame icon -->
                <g>
                  <!-- Outer frame -->
                  <rect x="10" y="10" width="50" height="50" fill="none" stroke="#1a3a5c" stroke-width="2"/>
                  <!-- Vertical divider -->
                  <line x1="35" y1="10" x2="35" y2="60" stroke="#1a3a5c" stroke-width="2"/>
                  <!-- Horizontal divider -->
                  <line x1="10" y1="35" x2="60" y2="35" stroke="#1a3a5c" stroke-width="2"/>
                </g>
                <!-- Text -->
                <g>
                  <!-- Main text "BB Kozijnen" -->
                  <text x="75" y="38" font-family="Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif" font-size="24" font-weight="600" fill="#2d2d2d">BB Kozijnen</text>
                  <!-- Subtext "Kunststof kozijnen op maat" -->
                  <text x="75" y="58" font-family="Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif" font-size="10" fill="#555555">Kunststof kozijnen op maat</text>
                </g>
              </svg>
            </a>
          </div>
          <nav class="flex flex-wrap items-center gap-3 text-sm text-[#2d2d2d]">
            <a href="/" class="hover:text-[#1a3a5c]">Home</a>
            <a href="/over-ons" class="hover:text-[#1a3a5c]">Over ons</a>
            <a href="/werkwijze" class="hover:text-[#1a3a5c]">Werkwijze</a>
            <a href="/offerte-aanvragen" class="hover:text-[#1a3a5c]">Offerte</a>
            <a href="/cube" class="rounded-full bg-[#1a3a5c] px-4 py-2 text-sm font-semibold text-white hover:bg-[#132642]">Diensten</a>
          </nav>
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="bg-[#f5f5f5] border-t border-[#e5e7eb] text-[#333333]">
        <div class="mx-auto max-w-7xl px-6 py-10 grid gap-6 md:grid-cols-[1.5fr_1fr]">
          <div>
            <p class="text-sm text-[#666666]">BB Kunststof Kozijnen</p>
            <p class="mt-4 max-w-xl text-[#555555]">Wij plaatsen hoogwaardige kunststof kozijnen bij particulieren door heel Nederland. Met aandacht voor energie, veiligheid en een modern uiterlijk.</p>
          </div>
          <div class="grid gap-4 text-sm text-[#555555]">
            <div>
              <p class="font-semibold text-[#2d2d2d]">Contact</p>
              <p class="mt-2">E-mail: info@bbkunststofkozijnen.nl</p>
              <p>Telefoon: 085 123 4567</p>
            </div>
            <div>
              <p class="font-semibold text-[#2d2d2d]">Werkgebied</p>
              <p class="mt-2">Regio Utrecht</p>
              <p>Noord-Holland</p>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

