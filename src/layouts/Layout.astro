---
import '../styles/global.css';
const { title = 'BB Kunststof Kozijnen', description = 'Professionele kunststof kozijnen voor particulieren in Nederland.' } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <style>html { scroll-behavior: smooth; }</style>
  </head>
  <body class="bg-white text-[#333333] antialiased">
    <div class="min-h-screen flex flex-col">
      <header class="bg-white border-b border-[#e5e7eb] sticky top-0 z-50">
        <div class="mx-auto max-w-7xl px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <a href="/" class="text-xl font-semibold tracking-tight text-[#2d2d2d]">BB Kunststof Kozijnen</a>
            <p class="text-sm text-[#666666] mt-1">Kozijnen voor Nederlandse woningen</p>
          </div>
          <nav class="flex flex-wrap items-center gap-3 text-sm text-[#2d2d2d]">
            <a href="/" class="hover:text-[#1a3a5c]">Home</a>
            <a href="/over-ons" class="hover:text-[#1a3a5c]">Over ons</a>
            <a href="/werkwijze" class="hover:text-[#1a3a5c]">Werkwijze</a>
            <a href="/offerte-aanvragen" class="hover:text-[#1a3a5c]">Offerte</a>
            <a href="/cube" class="rounded-full bg-[#1a3a5c] px-4 py-2 text-sm font-semibold text-white hover:bg-[#132642]">Diensten</a>
          </nav>
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="bg-[#f5f5f5] border-t border-[#e5e7eb] text-[#333333]">
        <div class="mx-auto max-w-7xl px-6 py-10 grid gap-6 md:grid-cols-[1.5fr_1fr]">
          <div>
            <p class="text-sm text-[#666666]">BB Kunststof Kozijnen</p>
            <p class="mt-4 max-w-xl text-[#555555]">Wij plaatsen hoogwaardige kunststof kozijnen bij particulieren door heel Nederland. Met aandacht voor energie, veiligheid en een modern uiterlijk.</p>
          </div>
          <div class="grid gap-4 text-sm text-[#555555]">
            <div>
              <p class="font-semibold text-[#2d2d2d]">Contact</p>
              <p class="mt-2">E-mail: info@bbkunststofkozijnen.nl</p>
              <p>Telefoon: 085 123 4567</p>
            </div>
            <div>
              <p class="font-semibold text-[#2d2d2d]">Werkgebied</p>
              <p class="mt-2">Regio Utrecht</p>
              <p>Noord-Holland</p>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

