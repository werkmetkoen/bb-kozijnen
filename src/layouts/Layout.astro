---
import '../styles/global.css';
import Logo from '../assets/logo.svg?raw';

const { title = 'BB Kunststof Kozijnen', description = 'Professionele kunststof kozijnen voor particulieren in Nederland.' } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c8922a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Raleway:wght@300;400;600&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <style>html { scroll-behavior: smooth; }</style>
  </head>
  <body class="antialiased">
    <div class="min-h-screen flex flex-col">
      <header class="partner-bar sticky top-0 z-50">
        <div class="mx-auto max-w-7xl header-inner">
          <div class="logo-container">
            <a href="/" class="block hover:opacity-80 transition-opacity">
              <svg viewBox="0 0 320 100" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
                <!-- Window frame icon -->
                <g>
                  <!-- Outer frame (60x60px, centered vertically) -->
                  <rect x="12" y="20" width="60" height="60" fill="none" stroke="white" stroke-width="3" stroke-linecap="round"/>
                  <!-- Vertical divider -->
                  <line x1="42" y1="20" x2="42" y2="80" stroke="white" stroke-width="3" stroke-linecap="round"/>
                  <!-- Horizontal divider -->
                  <line x1="12" y1="50" x2="72" y2="50" stroke="white" stroke-width="3" stroke-linecap="round"/>
                </g>
                <!-- Text (vertically centered) -->
                <g>
                  <!-- Main text "BB Kozijnen" -->
                  <text x="90" y="42" font-family="Raleway, sans-serif" font-size="20" font-weight="700" fill="white">BB Kozijnen</text>
                  <!-- Subtext "Kunststof kozijnen op maat" -->
                  <text x="90" y="63" font-family="Playfair Display, serif" font-style="italic" font-size="11" fill="var(--color-text-light)">Kunststof kozijnen op maat</text>
                </g>
              </svg>
            </a>
          </div>
          <nav class="desktop-nav">
            <div class="flex items-center gap-6">
              <div class="nav-dropdown-root">
                <a href="#" class="nav-link">Kunststof kozijnen</a>
                <div class="nav-dropdown-panel">
                  <a href="/city">City</a>
                  <a href="/cube">Cube</a>
                  <a href="/warmcore">Warmcore</a>
                  <a href="/edge">Edge</a>
                </div>
              </div>
              <div class="nav-dropdown-root">
                <a href="/isolatieglas" class="nav-link">Isolatieglas</a>
                <div class="nav-dropdown-panel">
                  <a href="/isolatieglas">HR++</a>
                  <a href="/isolatieglas">HR+++</a>
                </div>
              </div>
              <div class="nav-dropdown-root">
                <a href="/horren" class="nav-link">Horren</a>
                <div class="nav-dropdown-panel">
                  <a href="/horren">Inzethorren</a>
                  <a href="/horren">Rolhorren</a>
                  <a href="/horren">Plissé</a>
                  <a href="/horren">Deurhorren</a>
                </div>
              </div>
              <div class="nav-dropdown-root">
                <a href="/aluminium" class="nav-link">Aluminium kozijnen</a>
              </div>
            </div>

            <div class="ml-auto flex items-center gap-6">
              <a href="/over-ons" class="nav-link">Over ons</a>
              <a href="/werkwijze" class="nav-link">Werkwijze</a>
              <a href="/offerte-aanvragen" class="nav-cta inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-semibold">Offerte aanvragen</a>
            </div>
          </nav>
          
          <!-- Mobile Hamburger Button -->
          <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </header>

      <!-- Mobile Navigation Overlay -->
      <div class="mobile-nav-overlay" id="mobileOverlay"></div>

      <!-- Mobile Navigation Menu -->
      <div class="mobile-nav-menu" id="mobileMenu">
        <button class="mobile-nav-close" id="mobileCloseBtn">✕</button>
        
        <ul class="mobile-nav-list">
          <li class="mobile-nav-item">
            <button class="mobile-nav-link" data-menu="kunststof">
              <span class="mobile-nav-link-text">Kunststof kozijnen</span>
              <span class="mobile-nav-arrow">⌄</span>
            </button>
            <div class="mobile-nav-submenu" id="submenu-kunststof">
              <a href="/city">City</a>
              <a href="/cube">Cube</a>
              <a href="/warmcore">Warmcore</a>
              <a href="/edge">Edge</a>
            </div>
          </li>
          
          <li class="mobile-nav-item">
            <button class="mobile-nav-link" data-menu="isolatieglas">
              <span class="mobile-nav-link-text">Isolatieglas</span>
              <span class="mobile-nav-arrow">⌄</span>
            </button>
            <div class="mobile-nav-submenu" id="submenu-isolatieglas">
              <a href="/isolatieglas">HR++</a>
              <a href="/isolatieglas">HR+++</a>
            </div>
          </li>
          
          <li class="mobile-nav-item">
            <button class="mobile-nav-link" data-menu="horren">
              <span class="mobile-nav-link-text">Horren</span>
              <span class="mobile-nav-arrow">⌄</span>
            </button>
            <div class="mobile-nav-submenu" id="submenu-horren">
              <a href="/horren">Inzethorren</a>
              <a href="/horren">Rolhorren</a>
              <a href="/horren">Plissé</a>
              <a href="/horren">Deurhorren</a>
            </div>
          </li>
          
          <li class="mobile-nav-item">
            <a href="/aluminium" class="mobile-nav-link">
              <span class="mobile-nav-link-text">Aluminium kozijnen</span>
            </a>
          </li>
          
          <li class="mobile-nav-item">
            <a href="/over-ons" class="mobile-nav-link">
              <span class="mobile-nav-link-text">Over ons</span>
            </a>
          </li>
          
          <li class="mobile-nav-item">
            <a href="/werkwijze" class="mobile-nav-link">
              <span class="mobile-nav-link-text">Werkwijze</span>
            </a>
          </li>
        </ul>
        
        <div class="mobile-nav-bottom">
          <a href="/offerte-aanvragen" class="mobile-nav-cta">Offerte aanvragen</a>
        </div>
      </div>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="bg-bg-darker border-t border-border-light text-text-light">
        <div class="mx-auto max-w-7xl px-6 py-10 grid gap-6 md:grid-cols-[1.5fr_1fr]">
          <div>
            <p class="text-sm">BB Kunststof Kozijnen</p>
            <p class="mt-4 max-w-xl">Wij plaatsen hoogwaardige kunststof kozijnen bij particulieren door heel Nederland. Met aandacht voor energie, veiligheid en een modern uiterlijk.</p>
          </div>
          <div class="grid gap-4 text-sm text-text-light">
            <div>
              <p class="font-semibold">Contact</p>
              <p class="mt-2">E-mail: info@bbkunststofkozijnen.nl</p>
              <p>Telefoon: 085 123 4567</p>
            </div>
            <div>
              <p class="font-semibold">Werkgebied</p>
              <p class="mt-2">Actief in de regio Utrechtse Heuvelrug, Utrecht, De Meern, Veenendaal en omstreken.</p>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // Mobile menu toggle
      const mobileMenuBtn = document.getElementById('mobileMenuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      const mobileOverlay = document.getElementById('mobileOverlay');
      const mobileCloseBtn = document.getElementById('mobileCloseBtn');

      function openMenu() {
        mobileMenu.style.display = 'block';
        mobileOverlay.style.display = 'block';
      }

      function closeMenu() {
        mobileMenu.style.display = 'none';
        mobileOverlay.style.display = 'none';
      }

      mobileMenuBtn?.addEventListener('click', openMenu);
      mobileCloseBtn?.addEventListener('click', closeMenu);
      mobileOverlay?.addEventListener('click', closeMenu);

      // Mobile submenu accordion
      const menuButtons = document.querySelectorAll('[data-menu]');
      menuButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          const menuId = button.getAttribute('data-menu');
          const submenu = document.getElementById(`submenu-${menuId}`);
          
          if (submenu) {
            const isActive = submenu.style.display !== 'none' && submenu.style.display !== '';
            
            // Close all other submenus
            document.querySelectorAll('.mobile-nav-submenu').forEach(m => {
              m.style.display = 'none';
            });
            document.querySelectorAll('[data-menu]').forEach(b => {
              b.classList.remove('active');
            });
            
            // Toggle current submenu
            if (!isActive) {
              submenu.style.display = 'flex';
              button.classList.add('active');
            }
          }
        });
      });

      // Close mobile menu when a link is clicked
      const mobileMenuLinks = document.querySelectorAll('.mobile-nav-submenu a, .mobile-nav-item > a');
      mobileMenuLinks.forEach(link => {
        link.addEventListener('click', closeMenu);
      });
    </script>
  </body>
</html>


